DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
DASHSCOPE_CHAT_MODEL=qwen3.7-plus
# Speech recognition uses a separate general Model Studio API key.
ASR_API_KEY=
# Copy the OpenAI-compatible base URL from the same workspace/region.
# The app derives the native /api/v1/services/aigc/multimodal-generation/generation endpoint.
ASR_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ASR_MODEL=qwen-audio-3.1-asr-flash
PORT=3000
# Optional extra yt-dlp args (applied to all platforms).
# Bilibili/YouTube/Douyin etc. are auto-detected and get platform-specific args.
# Use this for proxy, extra cookies, or other global overrides:
# YTDLP_EXTRA_ARGS="--proxy http://127.0.0.1:7890 --cookies-from-browser chrome"
YTDLP_EXTRA_ARGS=
# Netscape-format cookies.txt. The only cookie source that works in the
# sandboxed Mac App Store build (the app cannot read Chrome's cookie store).
# Leave empty to use the browser cookie jar (direct builds only).
YTDLP_COOKIES_FILE=
# Prefer transcription-sized streams; choose the closest higher size if unavailable.
YTDLP_MAX_HEIGHT=480
# Parallel fragments for native DASH/HLS (1-16; plain HTTP files stay single-stream).
YTDLP_CONCURRENT_FRAGMENTS=4
# Audio chunks transcribed in parallel (1-8). Wall time is per-request latency,
# so 4 lanes turn a 48-min video from ~22 min into ~6 min. Stay under the
# model's 600 RPM limit; lower it to 1 or 2 on a flaky network.
ASR_CONCURRENCY=4
