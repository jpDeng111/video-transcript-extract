{
  "name": "video-script-extract",
  "version": "1.0.0",
  "description": "Local web app to extract transcripts from video URLs",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:local": "electron-builder --config.mac.timestamp=none",
    "dist:mas": "electron-builder --mac mas",
    "fetch:binaries": "bash scripts/fetch-binaries.sh",
    "check:mas": "node scripts/mas-preflight.js"
  },
  "build": {
    "appId": "local.video-script-extract",
    "productName": "视频转写问答",
    "asar": true,
    "files": [
      "electron/**/*",
      "assets/icon.png",
      "assets/icon.svg",
      "public/**/*",
      "lib/**/*",
      "server.js",
      "README.md",
      ".env.example",
      "package.json",
      "!jobs/**/*",
      "!data/**/*",
      "!tmp/**/*",
      "!.env",
      "!.git/**/*",
      "!.qoder/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.darwin.plist",
      "entitlementsInherit": "build/entitlements.darwin.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "mas": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "entitlements": "build/entitlements.mas.plist",
      "entitlementsInherit": "build/entitlements.mas.inherit.plist",
      "provisioningProfile": "build/embedded.provisionprofile",
      "artifactName": "${productName}-${version}-mas.${ext}",
      "type": "distribution"
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  }
}
